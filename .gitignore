# ============================================
# ELDefectAI - Git Ignore
# ============================================

# Python cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# IDE settings
.vscode/
.idea/

# Environment variables / secrets
.env
.env.*

# Logs
*.log

# Temporary files
*.tmp
*.temp

# OS-generated files
Thumbs.db
.DS_Store

# ============================================
# IMPORTANT:
# DO NOT ignore datasets, models, databases,
# embeddings, ONNX files, PyTorch files, PNGs,
# PKL/NPY files, etc.
#
# They are intentionally included in the repo
# and large files are handled using Git LFS.
# ============================================